+/**
+ * Fast polling: while an app is in front and no websocket is open (the hosted server refuses the websocket of the apps,
+ * and a phone app never had one), sync this often. One request without a payload takes about 0.1 s. After a failed sync
+ * (HTTP 429, no network) fast polling pauses for the back-off time so that it never hammers a struggling server.
+ */
+const FAST_POLLING_INTERVAL = 1_000
+const FAST_POLLING_MIN_INTERVAL = 500
+const FAST_POLLING_MAX_INTERVAL = 3_000
+const FAST_POLLING_BACKOFF = 60_000
 
@@ -168,2 +177,5 @@ export class SyncService
   private autoSyncTicksWithoutNotification = 0
+  private fastPollingTimer?: ReturnType<typeof setInterval>
+  private fastPollingIntervalMs = FAST_POLLING_INTERVAL
+  private fastPollingBackoffUntil = 0
 
@@ -218,2 +230,6 @@ export class SyncService
     ;(this.serverNotificationSyncTimeout as unknown) = undefined
+    if (this.fastPollingTimer) {
+      clearInterval(this.fastPollingTimer)
+    }
+    ;(this.fastPollingTimer as unknown) = undefined
     ;(this.sessionManager as unknown) = undefined
@@ -384,2 +400,57 @@ export class SyncService
 
+  /**
+   * Turns fast polling on or off (see FAST_POLLING_INTERVAL); the interval is kept between 0.5 and 3 seconds. The caller decides
+   * when it makes sense: an app that is in front and the owner switched the feature on. The tick does nothing while a
+   * websocket is open: then the server's notifications suffice.
+   */
+  public setFastPolling(enabled: boolean, intervalMs: number = FAST_POLLING_INTERVAL): void {
+    if (this.dealloced) {
+      return
+    }
+
+    const wanted = Math.round(intervalMs) || FAST_POLLING_INTERVAL
+    const interval = Math.min(FAST_POLLING_MAX_INTERVAL, Math.max(FAST_POLLING_MIN_INTERVAL, wanted))
+    const wasRunning = this.fastPollingTimer !== undefined
+
+    if (wasRunning && enabled && interval === this.fastPollingIntervalMs) {
+      return
+    }
+
+    if (wasRunning) {
+      clearInterval(this.fastPollingTimer)
+      this.fastPollingTimer = undefined
+    }
+
+    if (!enabled) {
+      return
+    }
+
+    this.fastPollingIntervalMs = interval
+    this.fastPollingTimer = setInterval(this.fastPollingTick.bind(this), interval)
+
+    if (!wasRunning && this.databaseLoaded) {
+      void this.sync({ sourceDescription: 'Fast polling started' })
+    }
+  }
+
+  private fastPollingTick(): void {
+    if (
+      this.dealloced ||
+      !this.databaseLoaded ||
+      !this.sessionManager.online() ||
+      this.sockets.isWebSocketConnectionOpen() ||
+      Date.now() < this.fastPollingBackoffUntil ||
+      this.opStatus.syncInProgress ||
+      this.syncFrequencyGuard.isSyncCallsThresholdReachedThisMinute()
+    ) {
+      return
+    }
+
+    void this.sync({ sourceDescription: 'Fast Poll' }).then(() => {
+      if (this.opStatus?.hasError()) {
+        this.fastPollingBackoffUntil = Date.now() + FAST_POLLING_BACKOFF
+      }
+    })
+  }
+
   /**
diff --git a/packages/web/src/javascripts/Application/FastPollingController.ts b/packages/web/src/javascripts/Application/FastPollingController.ts

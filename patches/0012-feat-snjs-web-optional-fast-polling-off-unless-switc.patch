@@ -0,0 +1,111 @@
+import { SyncServiceInterface } from '@standardnotes/snjs'
+
+/**
+ * Fast polling: the app asks the server for changes every second or so while it is in front (see SyncService.setFastPolling).
+ * It is OFF unless the owner switched it on, so a stock-like install behaves exactly like before. The settings live in the
+ * browser storage of the app (they survive restarts):
+ *   snfast.fastPolling            "1" = on, anything else = off (default)
+ *   snfast.fastPollingIntervalMs  500 to 3000 (default 1000)
+ *   snfast.fastPollingUnfocused   "1" = a desktop window that is visible but not focused keeps polling fast (default: only the focused window does)
+ * window.snfastSetFastPolling(true | false, { intervalMs, unfocused }) changes them and applies them at once, and
+ * window.snfastFastPollingStatus() reports the state; the control script uses both over the remote debugging port.
+ */
+const EnabledKey = 'snfast.fastPolling'
+const IntervalKey = 'snfast.fastPollingIntervalMs'
+const UnfocusedKey = 'snfast.fastPollingUnfocused'
+const DefaultIntervalMs = 1000
+
+type Options = { intervalMs?: number; unfocused?: boolean }
+
+type Api = {
+  snfastSetFastPolling?: (enabled: boolean, options?: Options) => void
+  snfastFastPollingStatus?: () => unknown
+}
+
+const read = (key: string): string | null => {
+  try {
+    return localStorage.getItem(key)
+  } catch {
+    return null
+  }
+}
+
+const write = (key: string, value: string): void => {
+  try {
+    localStorage.setItem(key, value)
+  } catch {
+    /* storage not available: the setting stays as it was */
+  }
+}
+
+export class FastPollingController {
+  private inBackground = false
+  private active = false
+
+  /** @param requireFocus a desktop or browser window polls fast only while it has the focus (unless the owner allows otherwise) */
+  constructor(
+    private sync: SyncServiceInterface,
+    private requireFocus: boolean,
+  ) {
+    document.addEventListener('visibilitychange', this.update)
+    window.addEventListener('focus', this.update)
+    window.addEventListener('blur', this.update)
+
+    const api = window as unknown as Api
+    api.snfastSetFastPolling = (enabled: boolean, options?: Options) => {
+      write(EnabledKey, enabled ? '1' : '0')
+      if (options?.intervalMs !== undefined) {
+        write(IntervalKey, String(Math.round(options.intervalMs)))
+      }
+      if (options?.unfocused !== undefined) {
+        write(UnfocusedKey, options.unfocused ? '1' : '0')
+      }
+      this.update()
+    }
+    api.snfastFastPollingStatus = () => ({
+      enabled: this.isEnabled(),
+      intervalMs: this.intervalMs(),
+      unfocused: this.allowsUnfocused(),
+      running: this.active,
+      visible: !document.hidden,
+      focused: document.hasFocus(),
+      inBackground: this.inBackground,
+    })
+
+    this.update()
+  }
+
+  /** Native mobile app events: the page itself may not learn that the app went to the background. */
+  setAppInBackground(inBackground: boolean): void {
+    this.inBackground = inBackground
+    this.update()
+  }
+
+  private isEnabled(): boolean {
+    return read(EnabledKey) === '1'
+  }
+
+  private allowsUnfocused(): boolean {
+    return read(UnfocusedKey) === '1'
+  }
+
+  private intervalMs(): number {
+    const stored = Number(read(IntervalKey))
+    return Number.isFinite(stored) && stored > 0 ? stored : DefaultIntervalMs
+  }
+
+  private update = (): void => {
+    const visible = !document.hidden && !this.inBackground
+    const focused = !this.requireFocus || this.allowsUnfocused() || document.hasFocus()
+
+    this.active = this.isEnabled() && visible && focused
+    this.sync.setFastPolling(this.active, this.intervalMs())
+  }
+
+  deinit(): void {
+    document.removeEventListener('visibilitychange', this.update)
+    window.removeEventListener('focus', this.update)
+    window.removeEventListener('blur', this.update)
+    this.sync.setFastPolling(false)
+  }
+}

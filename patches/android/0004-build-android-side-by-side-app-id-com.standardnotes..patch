From b9a8da496b5137f2790307ff1bcec769e4ebaf37 Mon Sep 17 00:00:00 2001
From: "SN Fast Sync (local)" <snfast@localhost.invalid>
Date: Wed, 11 Nov 2026 04:25:56 -0700
Subject: [PATCH] build(android): side-by-side app id
 com.standardnotes.fastsync and label "SN Fast"

Lets the patched build be installed next to the Play Store app instead of replacing it: a different
applicationId (a different app, its own data and its own Android Keystore entries) and a different
launcher label. The Kotlin namespace stays com.standardnotes so no source file moves. Signing stays
upstream's own release signingConfig, which reads the keystore from android/app/keystore.keystore and the
ANDROID_KEYSTORE_* environment variables: our CI writes our own personal key there. Known limits: the
Digital Asset Links statement (passkeys / hardware keys) belongs to the original package name, so WebAuthn
sign-in does not work in this build; the launcher icon is the same as the original.
---
 packages/mobile/android/app/build.gradle                    | 2 +-
 packages/mobile/android/app/src/main/res/values/strings.xml | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/packages/mobile/android/app/build.gradle b/packages/mobile/android/app/build.gradle
index 5fd9361..ec13948 100644
--- a/packages/mobile/android/app/build.gradle
+++ b/packages/mobile/android/app/build.gradle
@@ -85,3 +85,3 @@ android {
     defaultConfig {
-        applicationId "com.standardnotes"
+        applicationId "com.standardnotes.fastsync"
         minSdkVersion rootProject.ext.minSdkVersion
diff --git a/packages/mobile/android/app/src/main/res/values/strings.xml b/packages/mobile/android/app/src/main/res/values/strings.xml
index 4acc301..b45ecd9 100644
--- a/packages/mobile/android/app/src/main/res/values/strings.xml
+++ b/packages/mobile/android/app/src/main/res/values/strings.xml
@@ -1,3 +1,3 @@
 <resources>
-    <string name="app_name">Standard Notes</string>
+    <string name="app_name">SN Fast</string>
 

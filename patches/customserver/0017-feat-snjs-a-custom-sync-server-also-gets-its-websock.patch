+  describe('guessWebSocketUrl()', () => {
+    it('puts the websocket on the same host under /ws, secure for https', () => {
+      const service = createService()
+
+      expect(service.guessWebSocketUrl('https://sync.example.com:3443')).toBe('wss://sync.example.com:3443/ws')
+      expect(service.guessWebSocketUrl('http://host.example.org:3140')).toBe('ws://host.example.org:3140/ws')
+    })
+
+    it('keeps the path of the server url in front of /ws, so a server under a secret path gets its websocket under the same path', () => {
+      const service = createService()
+
+      expect(service.guessWebSocketUrl('https://sync.example.com/p/abc_DEF-123')).toBe('wss://sync.example.com/p/abc_DEF-123/ws')
+      expect(service.guessWebSocketUrl('https://sync.example.com/p/abc_DEF-123/')).toBe('wss://sync.example.com/p/abc_DEF-123/ws')
+      expect(service.guessWebSocketUrl('http://host.example.org:3140/p/abc?x=1#y')).toBe('ws://host.example.org:3140/p/abc/ws')
+    })
+
+    it('guesses nothing for localhost or for something that is not a url', () => {
+      const service = createService()
+
+      expect(service.guessWebSocketUrl('http://localhost:3127')).toBeUndefined()
+      expect(service.guessWebSocketUrl('http://127.0.0.1:3127')).toBeUndefined()
+      expect(service.guessWebSocketUrl('not a url')).toBeUndefined()
+    })
+  })

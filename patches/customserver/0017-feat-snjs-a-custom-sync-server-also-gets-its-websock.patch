   describe('isWebSocketUrlOnHostOf()', () => {
     it('is true only when the websocket lives on the same host and port as the sync server', () => {
@@ -179,4 +204,44 @@ describe('webSocketsService', () => {
     })
 
+    it('keeps two workspaces apart: each has its own websocket url, its own timers and its own failures', async () => {
+      const otherStorage = { setValue: jest.fn() } as unknown as jest.Mocked<StorageServiceInterface>
+      const hostedApi = { createConnectionToken: jest.fn().mockResolvedValue(tokenFailed) } as unknown as jest.Mocked<WebSocketApiServiceInterface>
+      const ownApi = { createConnectionToken: jest.fn().mockResolvedValue(tokenOk) } as unknown as jest.Mocked<WebSocketApiServiceInterface>
+      const hosted = new WebSocketsService(storageService, 'wss://sockets.standardnotes.com', hostedApi, internalEventBus)
+      const own = new WebSocketsService(otherStorage, undefined, ownApi, internalEventBus)
+      jest.spyOn(console, 'warn').mockImplementation(() => undefined)
+      const ownUrl = 'wss://sync.example.com:3443/ws'
+
+      /** the second workspace picks a custom server without a websocket url and gets wss://HOST/ws; the first keeps its own url */
+      own.setWebSocketUrl(own.guessWebSocketUrl('https://sync.example.com:3443'))
+      expect(otherStorage.setValue).toHaveBeenCalledWith(StorageKey.WebSocketUrl, ownUrl)
+      expect(storageService.setValue).not.toHaveBeenCalled()
+      expect(own.isWebSocketUrlOnHostOf('https://sync.example.com:3443')).toBe(true)
+      expect(hosted.isWebSocketUrlOnHostOf('https://sync.example.com:3443')).toBe(false)
+
+      await own.startWebSocketConnection()
+      await hosted.startWebSocketConnection()
+      const ownSockets = () => FakeWebSocket.instances.filter((s) => s.url.startsWith(ownUrl))
+      expect(ownSockets()).toHaveLength(1)
+      ownSockets()[0].open()
+      expect(own.isWebSocketConnectionOpen()).toBe(true)
+      expect(FakeWebSocket.instances.some((s) => s.url.startsWith('wss://sockets.standardnotes.com'))).toBe(false)
+
+      /** the hosted workspace keeps failing (quietly, with long waits); the other one stays connected and is never reconnected because of it */
+      await jest.advanceTimersByTimeAsync(3_600_000)
+      expect(hostedApi.createConnectionToken.mock.calls.length).toBeGreaterThanOrEqual(5)
+      expect(own.isWebSocketConnectionOpen()).toBe(true)
+      expect(ownSockets()).toHaveLength(1)
+
+      /** switching away from the hosted workspace stops all its timers and does not touch the other workspace */
+      const callsBefore = hostedApi.createConnectionToken.mock.calls.length
+      hosted.deinit()
+      await jest.advanceTimersByTimeAsync(3_600_000)
+      expect(hostedApi.createConnectionToken.mock.calls.length).toBe(callsBefore)
+      expect(own.isWebSocketConnectionOpen()).toBe(true)
+
+      own.deinit()
+    })
+
     it('reconnects with growing delays when the socket closes unexpectedly, then tells listeners to catch up', async () => {
       const service = await createConnectedService()
diff --git a/packages/services/src/Domain/Api/WebsocketsService.ts b/packages/services/src/Domain/Api/WebsocketsService.ts
index cf9c631..177e456 100644
--- a/packages/services/src/Domain/Api/WebsocketsService.ts
+++ b/packages/services/src/Domain/Api/WebsocketsService.ts
@@ -66,4 +66,25 @@ export class WebSocketsService extends AbstractService<WebSocketsServiceEvent, D
   }
 
+  /**
+   * The websocket URL to use when a custom sync server is chosen without one: the same host under /ws (wss for https, ws for http),
+   * which is where a self-hosted server with push serves it. The path of the server URL stays in front of /ws, so a server that is reached
+   * under a secret path (https://HOST/p/KEY) has its websocket at wss://HOST/p/KEY/ws.
+   * Nothing is guessed for localhost (the home server inside the desktop app has no websocket).
+   */
+  public guessWebSocketUrl(serverUrl: string): string | undefined {
+    try {
+      const url = new URL(serverUrl)
+      if (['localhost', '127.0.0.1', '[::1]'].includes(url.hostname)) {
+        return undefined
+      }
+
+      const pathPrefix = url.pathname.replace(/\/+$/, '')
+
+      return `${url.protocol === 'https:' ? 'wss' : 'ws'}://${url.host}${pathPrefix}/ws`
+    } catch {
+      return undefined
+    }
+  }
+
   public loadWebSocketUrl(): void {
     const storedValue = this.storageService.getValue<string | undefined>(StorageKey.WebSocketUrl)

@@ -588,5 +588,5 @@ export class SNApplication implements ApplicationInterface, AppGroupManagedAppli
     await this.setHost.execute(host)
 
-    this.sockets.setWebSocketUrl(websocketUrl)
+    this.sockets.setWebSocketUrl(websocketUrl ?? this.sockets.guessWebSocketUrl(host))
   }
 

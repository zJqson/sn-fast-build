+
+  private async openWebSocketConnection(): Promise<Result<void>> {
     const webSocketConectionToken = await this.createWebSocketConnectionToken()
     if (webSocketConectionToken === undefined) {
+      this.scheduleReconnect()
+
       return Result.fail('Failed to create WebSocket connection token')
@@ -53,2 +89,6 @@ export class WebSocketsService extends AbstractService<WebSocketsServiceEvent, D
 
+    if (!this.shouldStayConnected) {
+      return Result.ok()
+    }
+
     try {
@@ -57,3 +97,3 @@ export class WebSocketsService extends AbstractService<WebSocketsServiceEvent, D
       this.webSocket.onclose = this.onWebSocketClose.bind(this)
-      this.webSocket.onopen = this.beginWebSocketHeartbeat.bind(this)
+      this.webSocket.onopen = this.onWebSocketOpen.bind(this)
 
@@ -61,2 +101,4 @@ export class WebSocketsService extends AbstractService<WebSocketsServiceEvent, D
     } catch (error) {
+      this.scheduleReconnect()
+
       return Result.fail(`Error starting WebSocket connection: ${(error as Error).message}`)
@@ -65,2 +107,47 @@ export class WebSocketsService extends AbstractService<WebSocketsServiceEvent, D
 
+  /**
+   * Retries with growing delays, so that a failed token request or a failed connection does not leave
+   * the push channel dead until the app is restarted, and so that a server outage is not hammered.
+   */
+  private scheduleReconnect(): void {
+    if (!this.shouldStayConnected || this.reconnectTimeout) {
+      return
+    }
+
+    this.mayHaveMissedNotifications = true
+
+    let delay = this.RECONNECT_DELAYS[Math.min(this.reconnectAttempts, this.RECONNECT_DELAYS.length - 1)]
+    this.reconnectAttempts++
+
+    if (this.reconnectAttempts >= this.MAX_QUICK_FAILURES && Date.now() - this.lastOpenedAt > this.NO_RECENT_SUCCESS_AFTER) {
+      /** The server keeps refusing the connection and it never worked lately (for example a version gate): stop hammering it. */
+      delay = this.LONG_RECONNECT_DELAY
+      console.warn(`WebSocket: ${this.reconnectAttempts} failed connection attempts in a row, next try in ${delay / 1000} s`)
+    }
+
+    this.reconnectTimeout = setTimeout(() => {
+      this.reconnectTimeout = undefined
+      void this.startWebSocketConnection()
+    }, delay)
+  }
+
+  private clearReconnectTimeout(): void {
+    if (this.reconnectTimeout) {
+      clearTimeout(this.reconnectTimeout)
+    }
+    this.reconnectTimeout = undefined
+  }
+
+  private onWebSocketOpen(): void {
+    this.reconnectAttempts = 0
+    this.lastOpenedAt = Date.now()
+    this.beginWebSocketHeartbeat()
+
+    if (this.mayHaveMissedNotifications) {
+      /** Notifications sent while the connection was down are lost, so let listeners catch up. */
+      this.mayHaveMissedNotifications = false
+      void this.notifyEvent(WebSocketsServiceEvent.ConnectionReestablished)
+    }
+  }
+
   isWebSocketConnectionOpen(): boolean {
@@ -70,2 +157,4 @@ export class WebSocketsService extends AbstractService<WebSocketsServiceEvent, D
   public closeWebSocketConnection(): void {
+    this.shouldStayConnected = false
+    this.clearReconnectTimeout()
     this.webSocket?.close(this.CLOSE_CONNECTION_CODE, 'Closing application')
@@ -73,3 +162,31 @@ export class WebSocketsService extends AbstractService<WebSocketsServiceEvent, D
 
+  /**
+   * For when the app comes back to the foreground: the old socket may be dead without anyone knowing (it still
+   * reports OPEN), so replace it. Does nothing when no connection is wanted, one is being opened, or one was
+   * opened a moment ago.
+   */
+  public restartWebSocketConnection(): void {
+    if (!this.shouldStayConnected || this.webSocket?.readyState === WebSocket.CONNECTING) {
+      return
+    }
+
+    if (this.isWebSocketConnectionOpen() && Date.now() - this.lastOpenedAt < this.RESTART_MIN_INTERVAL) {
+      return
+    }
+
+    const oldWebSocket = this.webSocket
+    this.webSocket = undefined
+    this.clearReconnectTimeout()
+    this.reconnectAttempts = 0
+    this.mayHaveMissedNotifications = true
+
+    oldWebSocket?.close(this.RESTART_CONNECTION_CODE, 'Restarting')
+
+    void this.startWebSocketConnection()
+  }
+
   private beginWebSocketHeartbeat(): void {
+    if (this.webSocketHeartbeatInterval) {
+      clearInterval(this.webSocketHeartbeatInterval)
+    }
     this.webSocketHeartbeatInterval = setInterval(this.websocketHeartbeat.bind(this), this.HEARTBEAT_DELAY)
@@ -107,2 +224,7 @@ export class WebSocketsService extends AbstractService<WebSocketsServiceEvent, D
   private onWebSocketClose(event: CloseEvent) {
+    if (event.target !== this.webSocket) {
+      /** A socket that was already replaced (see restartWebSocketConnection): nothing left to clean up. */
+      return
+    }
+
     if (this.webSocketHeartbeatInterval) {
@@ -119,4 +241,6 @@ export class WebSocketsService extends AbstractService<WebSocketsServiceEvent, D
 
+    this.mayHaveMissedNotifications = true
+
     if (this.webSocket?.readyState === WebSocket.CLOSED) {
-      void this.startWebSocketConnection()
+      this.scheduleReconnect()
     }

+import { WebSocketApiServiceInterface } from '@standardnotes/api'
+
+import { WebSocketsService } from './WebsocketsService'
+import { StorageServiceInterface } from '../Storage/StorageServiceInterface'
+import { InternalEventBusInterface } from '../Internal/InternalEventBusInterface'
+import { StorageKey } from '../Storage/StorageKeys'
+
+describe('webSocketsService', () => {
+  const webSocketUrl = ''
+
+  let storageService: StorageServiceInterface
+  let webSocketApiService: WebSocketApiServiceInterface
+  let internalEventBus: InternalEventBusInterface
+
+  const createService = () => {
+    return new WebSocketsService(storageService, webSocketUrl, webSocketApiService, internalEventBus)
+  }
+
+  beforeEach(() => {
+    storageService = {} as jest.Mocked<StorageServiceInterface>
+    storageService.setValue = jest.fn()
+
+    internalEventBus = {} as jest.Mocked<InternalEventBusInterface>
+    internalEventBus.publish = jest.fn()
+
+    webSocketApiService = {} as jest.Mocked<WebSocketApiServiceInterface>
+    webSocketApiService.createConnectionToken = jest.fn().mockReturnValue({ token: 'foobar' })
+  })
+
+  describe('setWebSocketUrl()', () => {
+    it('saves url in local storage', () => {
+      const webSocketUrl = 'wss://test-websocket'
+      createService().setWebSocketUrl(webSocketUrl)
+      expect(storageService.setValue).toHaveBeenCalledWith(StorageKey.WebSocketUrl, webSocketUrl)
+    })
+  })
+
+  describe('connection recovery', () => {
+    class FakeWebSocket {
+      static CONNECTING = 0
+      static OPEN = 1
+      static CLOSING = 2
+      static CLOSED = 3
+      static instances: FakeWebSocket[] = []
+
+      readyState = FakeWebSocket.CONNECTING
+      onopen?: () => void
+      onclose?: (event: { code: number; target: unknown }) => void
+      onmessage?: (event: { data: string }) => void
+
+      constructor(public url: string) {
+        FakeWebSocket.instances.push(this)
+      }
+
+      send = jest.fn()
+
+      open() {
+        this.readyState = FakeWebSocket.OPEN
+        this.onopen?.()
+      }
+
+      /** The server refused the connection or it dropped without the app asking for it */
+      fail() {
+        this.readyState = FakeWebSocket.CLOSED
+        this.onclose?.({ code: 1006, target: this })
+      }
+
+      close(code?: number) {
+        this.readyState = FakeWebSocket.CLOSED
+        this.onclose?.({ code: code ?? 1000, target: this })
+      }
+    }
+
+    const tokenOk = { status: 200, data: { token: 'a-token' } }
+    const tokenFailed = { status: 500, data: { error: { message: 'boom' } } }
+
+    const createConnectedService = async () => {
+      webSocketApiService.createConnectionToken = jest.fn().mockResolvedValue(tokenOk)
+      const service = new WebSocketsService(storageService, 'wss://test-websocket', webSocketApiService, internalEventBus)
+      await service.startWebSocketConnection()
+      return service
+    }
+
+    beforeEach(() => {
+      jest.useFakeTimers()
+      FakeWebSocket.instances = []
+      ;(global as unknown as { WebSocket: unknown }).WebSocket = FakeWebSocket
+    })
+
+    afterEach(() => {
+      jest.useRealTimers()
+    })
+
+    it('retries with growing delays when the connection token cannot be created, until the connection is closed', async () => {
+      webSocketApiService.createConnectionToken = jest.fn().mockResolvedValue(tokenFailed)
+      const service = new WebSocketsService(storageService, 'wss://test-websocket', webSocketApiService, internalEventBus)
+
+      const result = await service.startWebSocketConnection()
+      expect(result.isFailed()).toBe(true)
+      expect(webSocketApiService.createConnectionToken).toHaveBeenCalledTimes(1)
+
+      await jest.advanceTimersByTimeAsync(0)
+      expect(webSocketApiService.createConnectionToken).toHaveBeenCalledTimes(2)
+
+      await jest.advanceTimersByTimeAsync(999)
+      expect(webSocketApiService.createConnectionToken).toHaveBeenCalledTimes(2)
+      await jest.advanceTimersByTimeAsync(1)
+      expect(webSocketApiService.createConnectionToken).toHaveBeenCalledTimes(3)
+
+      service.closeWebSocketConnection()
+      await jest.advanceTimersByTimeAsync(120_000)
+      expect(webSocketApiService.createConnectionToken).toHaveBeenCalledTimes(3)
+    })
+
+    it('waits ten minutes after five failed attempts in a row when it has not connected lately', async () => {
+      webSocketApiService.createConnectionToken = jest.fn().mockResolvedValue(tokenFailed)
+      const service = new WebSocketsService(storageService, 'wss://test-websocket', webSocketApiService, internalEventBus)
+      jest.spyOn(console, 'warn').mockImplementation(() => undefined)
+
+      await service.startWebSocketConnection()
+      await jest.advanceTimersByTimeAsync(0)
+      await jest.advanceTimersByTimeAsync(1_000)
+      await jest.advanceTimersByTimeAsync(2_000)
+      await jest.advanceTimersByTimeAsync(5_000)
+      expect(webSocketApiService.createConnectionToken).toHaveBeenCalledTimes(5)
+
+      await jest.advanceTimersByTimeAsync(599_999)
+      expect(webSocketApiService.createConnectionToken).toHaveBeenCalledTimes(5)
+      await jest.advanceTimersByTimeAsync(1)
+      expect(webSocketApiService.createConnectionToken).toHaveBeenCalledTimes(6)
+
+      service.closeWebSocketConnection()
+    })
+
+    it('reconnects with growing delays when the socket closes unexpectedly, then tells listeners to catch up', async () => {
+      const service = await createConnectedService()
+      expect(FakeWebSocket.instances).toHaveLength(1)
+
+      FakeWebSocket.instances[0].open()
+      expect(internalEventBus.publish).not.toHaveBeenCalled()
+
+      FakeWebSocket.instances[0].fail()
+      await jest.advanceTimersByTimeAsync(0)
+      expect(FakeWebSocket.instances).toHaveLength(2)
+
+      FakeWebSocket.instances[1].fail()
+      await jest.advanceTimersByTimeAsync(999)
+      expect(FakeWebSocket.instances).toHaveLength(2)
+      await jest.advanceTimersByTimeAsync(1)
+      expect(FakeWebSocket.instances).toHaveLength(3)
+
+      FakeWebSocket.instances[2].open()
+      expect(service.isWebSocketConnectionOpen()).toBe(true)
+      expect(internalEventBus.publish).toHaveBeenCalledWith(
+        expect.objectContaining({ type: 'WebSocketConnectionReestablished' }),
+      )
+    })
+
+    it('does not reconnect when the app closed the connection itself', async () => {
+      const service = await createConnectedService()
+      FakeWebSocket.instances[0].open()
+
+      service.closeWebSocketConnection()
+      await jest.advanceTimersByTimeAsync(120_000)
+
+      expect(FakeWebSocket.instances).toHaveLength(1)
+    })
+
+    it('replaces an open socket on restart and ignores the late close event of the replaced one', async () => {
+      const service = await createConnectedService()
+      FakeWebSocket.instances[0].open()
+
+      jest.setSystemTime(Date.now() + 11_000)
+      ;(service as unknown as { restartWebSocketConnection: () => void }).restartWebSocketConnection()
+      await jest.advanceTimersByTimeAsync(0)
+      expect(FakeWebSocket.instances).toHaveLength(2)
+
+      FakeWebSocket.instances[1].open()
+      FakeWebSocket.instances[0].onclose?.({ code: 4000, target: FakeWebSocket.instances[0] })
+      expect(service.isWebSocketConnectionOpen()).toBe(true)
+
+      await jest.advanceTimersByTimeAsync(120_000)
+      expect(FakeWebSocket.instances).toHaveLength(2)
+    })
+  })
+})

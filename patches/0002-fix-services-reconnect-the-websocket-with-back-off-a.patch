   private HEARTBEAT_DELAY = 360_000
+  /** Delays (ms) before reconnect attempts. The first attempt is immediate, the last delay repeats. */
+  private RECONNECT_DELAYS = [0, 1_000, 2_000, 5_000, 10_000, 20_000, 30_000]
+  /** After this many failed attempts in a row, and no successful connection in the last hour, wait LONG_RECONNECT_DELAY. */
+  private MAX_QUICK_FAILURES = 5
+  private LONG_RECONNECT_DELAY = 600_000
+  private NO_RECENT_SUCCESS_AFTER = 3_600_000
+  private RESTART_CONNECTION_CODE = 4000
+  private RESTART_MIN_INTERVAL = 10_000
+  private lastOpenedAt = 0
+  private reconnectTimeout?: ReturnType<typeof setTimeout>
+  private reconnectAttempts = 0
+  private shouldStayConnected = false
+  private mayHaveMissedNotifications = false
+  private isStartingConnection = false
 
@@ -48,4 +62,26 @@ export class WebSocketsService extends AbstractService<WebSocketsServiceEvent, D
 
+    this.shouldStayConnected = true
+    this.clearReconnectTimeout()
+
+    if (
+      this.webSocket?.readyState === WebSocket.OPEN ||
+      this.webSocket?.readyState === WebSocket.CONNECTING ||
+      this.isStartingConnection
+    ) {
